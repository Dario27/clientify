# Copia este archivo como .env y ajusta los valores. El .env NO se sube a git.
# Las variables VITE_* quedan incrustadas en el build: no pongas secretos aquí.

# URL base de la API que usa el navegador. Por defecto "/api" (mismo origen):
# en desarrollo pasa por el proxy de Vite y en producción la sirve Flask.
# Si apuntas a otro dominio (ej. https://api.midominio.com/api) el backend
# necesitará CORS y cookies SameSite=None; Secure.
VITE_API_URL=/api

# Backend al que el servidor de desarrollo de Vite redirige /api (solo `npm run dev`).
API_PROXY_TARGET=http://localhost:5000
