# Proxy inverso con HTTPS automático: Caddy saca y renueva solo el certificado de Let's Encrypt y
# redirige HTTP a HTTPS. El dominio viene de APP_DOMAIN (ver el servicio `caddy` de docker-compose.yml).
{$APP_DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy frontend:80
}
