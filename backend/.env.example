# Copia este archivo como .env y ajusta los valores. El .env NO se sube a git.

# Clave para firmar la cookie de sesión. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Servidor
FLASK_DEBUG=1
PORT=5000

# Ruta de la base SQLite (opcional; por defecto ../data/clientify.db)
# CLIENTIFY_DB=

# Admin que se crea la primera vez que se inicializa la base
ADMIN_EMAIL=<email@placeholder.com>
ADMIN_PASSWORD=<placeholder>

# Contraseña de los clientes de prueba que crea seed_demo.py
DEMO_PASSWORD=<password-placeholder>
